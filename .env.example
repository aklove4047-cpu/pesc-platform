NODE_ENV=development
PORT=3000
# Main domain. Centre sites become <slug>.BASE_DOMAIN
BASE_DOMAIN=localhost
PUBLIC_URL=http://localhost:3000
DB_FILE=./data/pesc.db

# First super admin (used by `npm run seed`). Choose a strong password (10+ chars).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# Provisioning health checks. Set both to true in production (needs wildcard DNS + HTTPS).
PROVISION_CHECK_DNS=false
PROVISION_CHECK_HTTPS=false

# Payments: HMAC secret shared with your gateway adapter/webhook sender
PAYMENT_WEBHOOK_SECRET=change-me-long-random

# Email: none | console (dev only) | smtp
EMAIL_PROVIDER=console
SMTP_URL=
MAIL_FROM="PESC <no-reply@pescouncil.in>"
